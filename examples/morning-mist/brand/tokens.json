{
  "$description": "Morning Mist Roasters (a fictional example brand). DTCG-style tokens with hex strings; build theme.css with build-theme.mjs.",
  "fontImport": {
    "$value": "https://fonts.googleapis.com/css2?family=Pridi:wght@400;600&family=IBM+Plex+Sans+Thai+Looped:wght@400;500;600&display=swap"
  },
  "color": {
