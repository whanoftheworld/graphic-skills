      },
      "950": {
        "$value": "#002213"
      }
    },
    "accent": {
      "50": {
        "$value": "#fff4f2"
      },
      "100": {
        "$value": "#ffe6e2"
      },
      "200": {
        "$value": "#ffcdc5"
      },
      "300": {
        "$value": "#ffab9f"
      },
      "400": {
        "$value": "#ea897c"
      },
      "500": {
        "$value": "#d3675a"
      },
      "600": {
        "$value": "#b3342a"
      },
      "700": {
        "$value": "#9c281f"
      },
      "800": {
        "$value": "#7b1510"
      },
      "900": {
        "$value": "#5c0202"
      },
      "950": {
        "$value": "#3b0000"
      }
    },
    "neutral": {
      "50": {
        "$value": "#f9f7f0"
      },
      "100": {
        "$value": "#efede5"
      },
      "200": {
        "$value": "#dedbd2"
      },
      "300": {
        "$value": "#c7c4ba"
      },
      "400": {
        "$value": "#aba79c"
      },
      "500": {
        "$value": "#908c7f"
      },
      "600": {
        "$value": "#767164"
      },
      "700": {
        "$value": "#5c584b"
      },
      "800": {
        "$value": "#464238"
      },
      "900": {
        "$value": "#312e25"
      },
      "950": {
        "$value": "#1d1a13"
      }
    },
    "primary": {
      "$value": "{color.brand.700}"
    },
    "secondary": {
      "$value": "{color.accent.600}"
    },
    "surface": {
      "base": {
        "$value": "{color.neutral.50}"
      },
      "sunken": {
        "$value": "{color.neutral.100}"
      },
      "brand": {
        "$value": "{color.brand.700}"
      },
      "deep": {
        "$value": "{color.brand.950}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.neutral.950}"
      },
      "secondary": {
        "$value": "{color.neutral.700}"
      },
      "onBrand": {
        "$value": "{color.neutral.50}"
      },
      "onAccent": {
        "$value": "{color.neutral.50}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{color.neutral.200}"
      },
      "strong": {
        "$value": "{color.neutral.500}"
      }
    },
    "semantic": {
      "success": {
        "$value": "{color.brand.700}"
      },
      "warning": {
        "$value": "#8a5a00"
      },
      "danger": {
        "$value": "{color.accent.700}"
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "display": {
      "$value": [
        "Pridi",
        "Noto Serif Thai",
        "serif"
      ]
    },
    "body": {
      "$value": [
        "IBM Plex Sans Thai Looped",
        "IBM Plex Sans",
        "sans-serif"
      ]
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      }
    }
  },
  "size": {
    "$type": "dimension",
    "caption": {
      "$value": {
        "value": 0.8,
        "unit": "rem"
      }
    },
    "body": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "lead": {
      "$value": {
        "value": 1.25,
        "unit": "rem"
      }
    },
    "h4": {
      "$value": {
        "value": 1.563,
        "unit": "rem"
      }
    },
    "h3": {
      "$value": {
        "value": 1.953,
        "unit": "rem"
      }
    },
    "h2": {
      "$value": {
        "value": 2.441,
        "unit": "rem"
      }
    },
    "h1": {
      "$value": {
        "value": 3.052,
        "unit": "rem"
      }
    },
    "display": {
      "$value": {
        "value": 3.815,
        "unit": "rem"
      }
    }
  },
  "leading": {
    "$type": "number",
    "body": {
      "$value": 1.7
    },
    "heading": {
      "$value": 1.3
    },
    "tight": {
      "$value": 1.15
    }
  },
  "space": {
    "$type": "dimension",
    "3xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2xs": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "xs": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "s": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "m": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "l": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "2xl": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    },
    "3xl": {
      "$value": {
        "value": 96,
        "unit": "px"
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "pill": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": "0 1px 2px rgb(29 26 19 / 0.08), 0 8px 24px rgb(29 26 19 / 0.08)"
    }
  },
  "dark": {
    "color": {
      "surface": {
        "base": {
          "$value": "{color.neutral.950}"
        },
        "sunken": {
          "$value": "{color.neutral.900}"
        },
        "brand": {
          "$value": "{color.brand.900}"
        }
      },
      "text": {
        "primary": {
          "$value": "{color.neutral.50}"
        },
        "secondary": {
          "$value": "{color.neutral.300}"
        },
        "onBrand": {
          "$value": "{color.neutral.50}"
        }
      },
      "border": {
        "subtle": {
          "$value": "{color.neutral.800}"
        },
        "strong": {
          "$value": "{color.neutral.600}"
        }
      },
      "primary": {
        "$value": "{color.brand.400}"
      },
      "secondary": {
        "$value": "{color.accent.400}"
      }
    }
  },
  "$extensions": {
    "graphic-skills": {
      "pairs": [
        {
          "fg": "{color.text.primary}",
          "bg": "{color.surface.base}",
          "use": "body text on page",
          "need": "text"
        },
        {
          "fg": "{color.text.secondary}",
          "bg": "{color.surface.base}",
          "use": "secondary text on page",
          "need": "text"
        },
        {
          "fg": "{color.text.primary}",
          "bg": "{color.surface.sunken}",
          "use": "body text on sunken surface",
          "need": "text"
        },
        {
          "fg": "{color.text.secondary}",
          "bg": "{color.surface.sunken}",
          "use": "secondary text on sunken surface",
          "need": "text"
        },
        {
          "fg": "{color.text.onBrand}",
          "bg": "{color.surface.brand}",
          "use": "text on brand green",
          "need": "text"
        },
        {
          "fg": "{color.text.onBrand}",
          "bg": "{color.surface.deep}",
          "use": "text on deep green",
          "need": "text"
        },
        {
          "fg": "{color.primary}",
          "bg": "{color.surface.base}",
          "use": "links and primary buttons on page",
          "need": "text"
        },
        {
          "fg": "{color.secondary}",
          "bg": "{color.surface.base}",
          "use": "accent labels on page",
          "need": "text"
        },
        {
          "fg": "{color.text.onAccent}",
          "bg": "{color.secondary}",
          "use": "text on accent button",
          "need": "text"
        },
        {
          "fg": "{color.border.strong}",
          "bg": "{color.surface.base}",
          "use": "input borders and focus rings",
          "need": "ui"
        },
        {
          "fg": "{color.text.primary}",
          "bg": "{color.surface.base}",
          "use": "body text on page",
          "need": "text",
          "mode": "dark"
        },
        {
          "fg": "{color.text.secondary}",
          "bg": "{color.surface.base}",
          "use": "secondary text on page",
          "need": "text",
          "mode": "dark"
        },
        {
          "fg": "{color.text.primary}",
          "bg": "{color.surface.sunken}",
          "use": "body text on sunken surface",
          "need": "text",
          "mode": "dark"
        },
        {
          "fg": "{color.text.onBrand}",
          "bg": "{color.surface.brand}",
          "use": "text on brand surface",
          "need": "text",
          "mode": "dark"
        },
        {
          "fg": "{color.primary}",
          "bg": "{color.surface.base}",
          "use": "links on page",
          "need": "text",
          "mode": "dark"
        },
        {
          "fg": "{color.secondary}",
          "bg": "{color.surface.base}",
          "use": "accent labels on page",
          "need": "text",
          "mode": "dark"
        },
        {
          "fg": "{color.border.strong}",
          "bg": "{color.surface.base}",
          "use": "input borders",
          "need": "ui",
          "mode": "dark"
        }
      ]
    }
  }
}
